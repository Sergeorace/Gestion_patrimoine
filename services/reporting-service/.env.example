APP_NAME="Reporting Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=reporting_db
DB_USERNAME=${DB_USER:-patrimoine}
DB_PASSWORD=${DB_PASSWORD}

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=database

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# JWT (RS256) - auth-service possede la cle privee, tous verifient avec la publique
JWT_PUBLIC_KEY_FILE=/etc/patrimoine/jwt_public.pem
JWT_PRIVATE_KEY_FILE=/etc/patrimoine/jwt_private.pem   # auth-service uniquement
JWT_ACCESS_TTL=900        # 15 min
JWT_REFRESH_TTL=604800    # 7 jours

# RabbitMQ (evenements metier)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=${RABBITMQ_USER:-patrimoine}
RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD}
RABBITMQ_VHOST=/

# URLs internes des autres services (appels inter-services)
AUTH_SERVICE_URL=http://auth-service:8000
ORGANISATION_SERVICE_URL=http://organisation-service:8000
ASSET_SERVICE_URL=http://asset-service:8000
MOVEMENT_SERVICE_URL=http://movement-service:8000
INVENTORY_SERVICE_URL=http://inventory-service:8000
MAINTENANCE_SERVICE_URL=http://maintenance-service:8000
VALUATION_SERVICE_URL=http://valuation-service:8000
DOCUMENT_SERVICE_URL=http://document-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
REPORTING_SERVICE_URL=http://reporting-service:8000

# Notifications externes (optionnel)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=patrimoine@etat.tg
MAIL_FROM_NAME="Patrimoine Etat"
